{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brand brief",
  "description": "用户提供或确认过的品牌输入。null / 空数组表示尚未提供，不是品牌事实。",
  "type": "object",
  "required": ["name", "product", "audience", "markets", "personality", "deliverables"],
  "additionalProperties": false,
  "$defs": {
    "text": { "type": ["string", "null"] },
    "list": { "type": "array", "items": { "type": "string" } },
    "reference": {
      "type": "object",
      "required": ["brand", "why"],
      "properties": { "brand": { "type": "string" }, "why": { "type": "string" } },
      "additionalProperties": false
    },
    "platform": {
      "enum": ["web", "desktop", "ios", "android"]
    },
    "stackProfile": {
      "enum": ["html-css-js", "react"]
    },
    "deliveryStatus": {
      "enum": ["preview-only", "handoff-ready"]
    },
    "frontendConstraints": {
      "type": "object",
      "required": ["platforms", "stackProfile", "deliveryStatus"],
      "properties": {
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/platform" },
          "uniqueItems": true
        },
        "stackProfile": { "$ref": "#/$defs/stackProfile" },
        "deliveryStatus": { "$ref": "#/$defs/deliveryStatus" }
      },
      "additionalProperties": false
    },
    "unitKind": {
      "enum": ["page-map", "layout", "component", "page", "platform-adaptation"]
    },
    "unitStatus": {
      "enum": ["in-progress", "in-review", "approved", "changes-requested", "completed"]
    },
    "approvalStatus": {
      "enum": ["pending", "approved", "changes-requested"]
    },
    "fileRange": {
      "type": "object",
      "required": ["path", "startLine", "endLine"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "manifestUnit": {
      "type": "object",
      "required": ["id", "kind", "status", "files", "platforms"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/unitKind" },
        "status": { "$ref": "#/$defs/unitStatus" },
        "files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/platform" },
          "minItems": 1,
          "uniqueItems": true
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "uiConfig": {
      "type": "object",
      "required": ["version", "platforms", "stackProfile", "tokenSource", "deliveryStatus"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/platform" },
          "minItems": 1,
          "uniqueItems": true
        },
        "stackProfile": { "$ref": "#/$defs/stackProfile" },
        "tokenSource": { "const": "tokens/src" },
        "deliveryStatus": { "$ref": "#/$defs/deliveryStatus" }
      },
      "additionalProperties": false
    },
    "irManifest": {
      "type": "object",
      "required": ["manifestVersion", "hash", "units"],
      "properties": {
        "manifestVersion": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "units": {
          "type": "array",
          "items": { "$ref": "#/$defs/manifestUnit" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "statusUnit": {
      "type": "object",
      "required": ["unitId", "status"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/unitStatus" },
        "updatedAt": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "gateApproval": {
      "type": "object",
      "required": ["kind", "gate", "status", "scope", "snapshot", "confirmation", "approvedAt"],
      "properties": {
        "kind": { "const": "gate" },
        "gate": { "type": "string", "pattern": "^G[1-5]$" },
        "status": { "$ref": "#/$defs/approvalStatus" },
        "scope": { "type": "string", "minLength": 1 },
        "snapshot": { "type": "string", "minLength": 1 },
        "confirmation": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "minLength": 1 }
      },
      "anyOf": [{ "required": ["version"] }, { "required": ["hash"] }],
      "additionalProperties": false
    },
    "unitReviewApproval": {
      "type": "object",
      "required": [
        "kind",
        "status",
        "unitId",
        "manifestVersion",
        "manifestHash",
        "fileScope",
        "reviewer",
        "conclusion",
        "evidence"
      ],
      "properties": {
        "kind": { "const": "unit-review" },
        "status": { "$ref": "#/$defs/unitStatus" },
        "unitId": { "type": "string", "minLength": 1 },
        "manifestVersion": { "type": "string", "minLength": 1 },
        "manifestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "fileScope": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileRange" },
          "minItems": 1
        },
        "reviewer": {
          "type": "object",
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "subagent" },
            "name": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "conclusion": {
          "enum": ["approved", "changes-requested"]
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "approvalRecord": {
      "oneOf": [
        { "$ref": "#/$defs/gateApproval" },
        { "$ref": "#/$defs/unitReviewApproval" }
      ]
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "object",
      "properties": {
        "official": { "$ref": "#/$defs/text", "description": "正式名称，按用户指定拼写与大小写" },
        "pronunciation": { "$ref": "#/$defs/text" },
        "zh": { "$ref": "#/$defs/text" },
        "en": { "$ref": "#/$defs/text" },
        "relationship": { "$ref": "#/$defs/text", "description": "中英文名的关系：直译 / 音译 / 各自独立 / 只用一种" },
        "final": { "type": "boolean", "description": "名称是否已定；false 时不得发布最终字标" }
      },
      "additionalProperties": false
    },
    "domain": { "$ref": "#/$defs/text", "description": "仅作为用户输入，不推断所有权或可注册性" },
    "product": {
      "type": "object",
      "properties": {
        "oneLiner": { "$ref": "#/$defs/text" },
        "category": { "$ref": "#/$defs/text" },
        "capabilities": { "$ref": "#/$defs/list" },
        "nonGoals": { "$ref": "#/$defs/list", "description": "明确不做什么" }
      },
      "additionalProperties": false
    },
    "audience": {
      "type": "object",
      "properties": {
        "users": { "$ref": "#/$defs/list" },
        "buyers": { "$ref": "#/$defs/list" },
        "scenarios": { "$ref": "#/$defs/list" },
        "trust": { "$ref": "#/$defs/list", "description": "希望建立的信任" }
      },
      "additionalProperties": false
    },
    "markets": {
      "type": "object",
      "properties": {
        "current": { "$ref": "#/$defs/list" },
        "languages": { "$ref": "#/$defs/list", "description": "如 zh-Hans、zh-Hant、en、ja；不从用户所在地推断" },
        "future": { "$ref": "#/$defs/list" }
      },
      "additionalProperties": false
    },
    "personality": {
      "type": "object",
      "properties": {
        "traits": { "$ref": "#/$defs/list", "maxItems": 5 },
        "avoid": { "$ref": "#/$defs/list", "maxItems": 5 }
      },
      "additionalProperties": false
    },
    "references": {
      "type": "object",
      "properties": {
        "likes": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "dislikes": { "type": "array", "items": { "$ref": "#/$defs/reference" } }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "existingLogo": { "$ref": "#/$defs/text", "description": "路径或说明" },
        "colors": { "$ref": "#/$defs/list" },
        "typefaces": { "$ref": "#/$defs/list" },
        "licensing": { "$ref": "#/$defs/text" },
        "techStack": { "$ref": "#/$defs/text" },
        "frontend": { "$ref": "#/$defs/frontendConstraints" },
        "repoConventions": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "deliverables": {
      "type": "array",
      "items": {
        "enum": ["web", "ios", "android", "desktop", "extension", "marketing", "social", "email", "docs", "presentation", "business", "print", "merch"]
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "object",
      "properties": {
        "designTools": { "$ref": "#/$defs/list" },
        "network": { "type": ["boolean", "null"] },
        "canInstallDependencies": { "type": ["boolean", "null"] },
        "fontSources": { "$ref": "#/$defs/list" }
      },
      "additionalProperties": false
    }
  }
}
